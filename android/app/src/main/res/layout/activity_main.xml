<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070B14">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
<LinearLayout android:layout_width="190dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="#0B1220">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AETHERPS3" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLAYSTATION 3 EMULATOR" android:textColor="#718096" android:textSize="8sp" android:layout_marginTop="3dp"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="#1C2A3D"/>
<TextView android:id="@+id/navHome" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:paddingStart="12dp" android:text="HOME" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:clickable="true"/>
<TextView android:id="@+id/navGames" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="12dp" android:text="GAMES" android:textColor="#A5B3C7" android:textSize="13sp" android:textStyle="bold" android:clickable="true"/>
<TextView android:id="@+id/navDownloads" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="12dp" android:text="DOWNLOADS" android:textColor="#A5B3C7" android:textSize="13sp" android:textStyle="bold" android:clickable="true"/>
<TextView android:id="@+id/navSettings" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="12dp" android:text="SETTINGS" android:textColor="#A5B3C7" android:textSize="13sp" android:textStyle="bold" android:clickable="true"/>
<TextView android:id="@+id/navAbout" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="12dp" android:text="ABOUT" android:textColor="#A5B3C7" android:textSize="13sp" android:textStyle="bold" android:clickable="true"/>
<Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/><TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#718096" android:textSize="9sp"/>
</LinearLayout>
<ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="34dp">
<TextView android:id="@+id/pageEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AETHERPS3 • EMULATOR FRONTEND" android:textColor="#5EA8FF" android:textSize="10sp" android:textStyle="bold"/>
<TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Welcome back" android:textColor="#FFFFFF" android:textSize="31sp" android:textStyle="bold"/>
<TextView android:id="@+id/pageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Your PlayStation 3 library and emulator controls." android:textColor="#91A4BD" android:textSize="13sp"/>
<LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="vertical" android:padding="24dp" android:background="#0F1827">
<TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Build your PS3 library" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:id="@+id/heroBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Add a legally obtained PS3 game folder, ISO or compatible game source." android:textColor="#A8B6C8" android:textSize="13sp"/>
<Button android:id="@+id/addGameButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="20dp" android:text="IMPORT GAME"/>
<Button android:id="@+id/addFolderButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="ADD GAMES FOLDER"/>
</LinearLayout>
<LinearLayout android:id="@+id/gamesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/libraryCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 GAMES" android:textColor="#91A4BD" android:textSize="11sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/gamesList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
<Button android:id="@+id/addGameButtonGames" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="IMPORT GAME"/>
<Button android:id="@+id/addFolderButtonGames" android:layout_width="wrap_content" android:layout_height="48dp" android:text="ADD GAMES FOLDER"/>
</LinearLayout>
<LinearLayout android:id="@+id/downloadsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="28dp"><TextView android:id="@+id/downloadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No active downloads." android:textColor="#A8B6C8" android:textSize="15sp"/></LinearLayout>
<LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="28dp"><Button android:id="@+id/graphicsSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="GRAPHICS &amp; VULKAN"/><Button android:id="@+id/audioSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="AUDIO"/><Button android:id="@+id/controllerSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="CONTROLLER &amp; INPUT"/><Button android:id="@+id/emulationSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="EMULATION &amp; PERFORMANCE"/><Button android:id="@+id/systemSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="SYSTEM &amp; FIRMWARE"/><Button android:id="@+id/storageSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="STORAGE &amp; GAME PATHS"/><Button android:id="@+id/advancedSettings" android:layout_width="match_parent" android:layout_height="56dp" android:text="ADVANCED &amp; DEBUG"/></LinearLayout>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#667892" android:textSize="11sp"/>
</LinearLayout></ScrollView></LinearLayout></FrameLayout>