<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/rootContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050D16" android:keepScreenOn="true" tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <LinearLayout android:id="@+id/navigationRail" android:layout_width="190dp" android:layout_height="match_parent" android:background="#030911" android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/aether_logo" android:contentDescription="AetherPS3"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AETHERPS3" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLAY BEYOND" android:textColor="#5D7891" android:textSize="7sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/navHome" style="@style/NavItem" android:text="⌂   Home" android:background="#102B44"/>
            <TextView android:id="@+id/navGames" style="@style/NavItem" android:text="▣   Games"/>
            <TextView android:id="@+id/navLibrary" style="@style/NavItem" android:text="▤   Library"/>
            <TextView android:id="@+id/navDownloads" style="@style/NavItem" android:text="⇩   Downloads"/>
            <TextView android:id="@+id/navSettings" style="@style/NavItem" android:text="⚙   Settings"/>
            <TextView android:id="@+id/navAbout" style="@style/NavItem" android:text="ⓘ   About"/>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#536B82" android:textSize="8sp"/>
        </LinearLayout>
        <ScrollView android:id="@+id/mainScroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:id="@+id/contentContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="match_parent" android:orientation="vertical" android:padding="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome Back!" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Play your favorite PS3 games on Android." android:textColor="#839AAF" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/readyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  EMULATOR READY" android:textColor="#45D98D" android:textSize="8sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeHero" android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="18dp" android:background="#0A1B2D" android:gravity="center_vertical" android:orientation="vertical" android:padding="26dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AETHERPS3  •  ANDROID" android:textColor="#54ADFF" android:textSize="8sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Greater Games. Anywhere." android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/>
                    <TextView android:layout_width="520dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="A premium PS3 emulation frontend designed for Android — clean, powerful and ready to grow with the emulator core." android:textColor="#91A8BF" android:textSize="11sp"/>
                    <Button android:id="@+id/browseGamesButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginTop="14dp" android:backgroundTint="#087FF1" android:minWidth="0dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="Browse Games  →" android:textAllCaps="false" android:textColor="#FFFFFF"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeActions" android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/addGameButton" style="@style/ActionCard" android:text="＋  Add Game\nSelect a game file"/>
                    <Button android:id="@+id/scanButton" style="@style/ActionCard" android:text="⌕  Scan Library\nFind PS3 games"/>
                    <Button android:id="@+id/configureButton" style="@style/ActionCard" android:text="⚙  Configure\nOptimize emulator"/>
                    <Button android:id="@+id/resumeButton" style="@style/ActionCard" android:text="▶  Resume\nContinue playing"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Recent Games" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <LinearLayout android:id="@+id/recentGamesRow" android:layout_width="match_parent" android:layout_height="205dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <ImageView android:layout_width="150dp" android:layout_height="190dp" android:layout_marginEnd="10dp" android:src="@drawable/card_game_1" android:scaleType="fitXY" android:contentDescription="Game placeholder"/>
                        <ImageView android:layout_width="150dp" android:layout_height="190dp" android:layout_marginEnd="10dp" android:src="@drawable/card_game_1" android:scaleType="fitXY" android:contentDescription="Game placeholder"/>
                        <ImageView android:layout_width="150dp" android:layout_height="190dp" android:src="@drawable/card_game_1" android:scaleType="fitXY" android:contentDescription="Game placeholder"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/sectionPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/sectionHeading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/sectionDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#7F96AB" android:textSize="10sp"/>
                    <LinearLayout android:id="@+id/settingsLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:visibility="gone">
                        <LinearLayout android:id="@+id/settingsCategories" android:layout_width="190dp" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/settingsGeneral" style="@style/SettingCategory" android:text="General" android:background="#102B44"/>
                            <TextView android:id="@+id/settingsSystem" style="@style/SettingCategory" android:text="System"/>
                            <TextView android:id="@+id/settingsGraphics" style="@style/SettingCategory" android:text="Graphics"/>
                            <TextView android:id="@+id/settingsAudio" style="@style/SettingCategory" android:text="Audio"/>
                            <TextView android:id="@+id/settingsController" style="@style/SettingCategory" android:text="Controller"/>
                            <TextView android:id="@+id/settingsEmulation" style="@style/SettingCategory" android:text="Emulation"/>
                            <TextView android:id="@+id/settingsAdvanced" style="@style/SettingCategory" android:text="Advanced"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/settingsContent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/gamesLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="45dp" android:background="#0A1B2D" android:gravity="center_vertical" android:paddingStart="16dp" android:text="Search games...                                      ⌕" android:textColor="#6F879D" android:textSize="11sp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="205dp" android:layout_marginTop="14dp" android:orientation="horizontal">
                            <ImageView android:layout_width="150dp" android:layout_height="190dp" android:src="@drawable/card_game_1" android:scaleType="fitXY" android:contentDescription="Game placeholder"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="190dp" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical" android:padding="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your PS3 Library" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Add legally obtained game data to populate this library. Artwork shown here is a placeholder asset." android:textColor="#8197AA" android:textSize="10sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/infoContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#0A1B2D" android:padding="22dp" android:textColor="#A4B6C6" android:textSize="11sp" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
