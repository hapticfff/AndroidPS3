<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/aether_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <LinearLayout android:layout_width="214dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/aether_panel">
            <TextView android:layout_width="match_parent" android:layout_height="42dp" android:text="AETHERPS3" android:textColor="@color/aether_text" android:textSize="21sp" android:textStyle="bold" android:gravity="center_vertical" android:letterSpacing="0.08"/>
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="PS3 EMULATOR" android:textColor="@color/aether_blue" android:textSize="9sp" android:textStyle="bold" android:gravity="center_vertical"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/aether_line"/>
            <TextView android:id="@+id/navHome" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="⌂   HOME" android:textColor="@color/aether_text" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/navGames" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="▣   GAMES" android:textColor="@color/aether_muted" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/navDownloads" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="↓   DOWNLOADS" android:textColor="@color/aether_muted" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/navSettings" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="⚙   SETTINGS" android:textColor="@color/aether_muted" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/navAbout" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="ⓘ   ABOUT" android:textColor="@color/aether_muted" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="24dp" android:textColor="@color/aether_muted" android:textSize="9sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="20dp" android:text="ARM64  •  VULKAN" android:textColor="@color/aether_blue" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
                <TextView android:id="@+id/pageEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AETHERPS3  •  EMULATOR" android:textColor="@color/aether_blue" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Welcome back" android:textColor="@color/aether_text" android:textSize="30sp" android:textStyle="bold"/>
                <TextView android:id="@+id/pageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Your games, emulator configuration and system tools." android:textColor="@color/aether_muted" android:textSize="13sp"/>
                <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@color/aether_panel_2">
                        <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your library starts here" android:textColor="@color/aether_text" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/heroBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Import your legally obtained PS3 games and AetherPS3 will keep them organized in one library." android:textColor="@color/aether_muted" android:textSize="13sp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
                            <Button android:id="@+id/addGameButton" android:layout_width="170dp" android:layout_height="48dp" android:text="IMPORT GAME" android:textStyle="bold"/>
                            <Button android:id="@+id/addFolderButton" android:layout_width="190dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:text="ADD GAMES FOLDER" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1" android:padding="18dp" android:background="@color/aether_panel" android:text="LIBRARY\nReady for your games" android:textColor="@color/aether_muted" android:textSize="12sp" android:gravity="center_vertical"/>
                        <TextView android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1" android:layout_marginStart="10dp" android:padding="18dp" android:background="@color/aether_panel" android:text="RENDERER\nVulkan • ARM64" android:textColor="@color/aether_muted" android:textSize="12sp" android:gravity="center_vertical"/>
                        <TextView android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1" android:layout_marginStart="10dp" android:padding="18dp" android:background="@color/aether_panel" android:text="CORE\nPPU foundation" android:textColor="@color/aether_muted" android:textSize="12sp" android:gravity="center_vertical"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/gamesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/libraryCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0 GAMES" android:textColor="@color/aether_muted" android:textSize="11sp" android:textStyle="bold"/>
                        <Button android:id="@+id/addGameButtonGames" android:layout_width="150dp" android:layout_height="44dp" android:text="IMPORT GAME"/>
                        <Button android:id="@+id/addFolderButtonGames" android:layout_width="175dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="ADD FOLDER"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/gamesList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/downloadsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="22dp" android:orientation="vertical" android:background="@color/aether_panel" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DOWNLOADS" android:textColor="@color/aether_text" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/downloadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No active downloads." android:textColor="@color/aether_muted" android:textSize="13sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GRAPHICS &amp; VULKAN" android:textColor="@color/aether_text" android:textSize="16sp" android:textStyle="bold" android:padding="18dp" android:background="@color/aether_panel"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Renderer: Vulkan\nResolution: Native\nShader cache: Enabled\nVSync: Auto" android:textColor="@color/aether_muted" android:textSize="13sp" android:padding="18dp" android:background="@color/aether_panel_2"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="CONTROLLER &amp; INPUT" android:textColor="@color/aether_text" android:textSize="16sp" android:textStyle="bold" android:padding="18dp" android:background="@color/aether_panel"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Touch controls: On\nController backend: Android\nAnalog deadzone: Default" android:textColor="@color/aether_muted" android:textSize="13sp" android:padding="18dp" android:background="@color/aether_panel_2"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="AUDIO" android:textColor="@color/aether_text" android:textSize="16sp" android:textStyle="bold" android:padding="18dp" android:background="@color/aether_panel"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Output: System default\nLatency: Balanced\nVolume: 100%" android:textColor="@color/aether_muted" android:textSize="13sp" android:padding="18dp" android:background="@color/aether_panel_2"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="SYSTEM &amp; FIRMWARE" android:textColor="@color/aether_text" android:textSize="16sp" android:textStyle="bold" android:padding="18dp" android:background="@color/aether_panel"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Firmware: User-provided\nGame directories: Managed by library\nLogs: Enabled" android:textColor="@color/aether_muted" android:textSize="13sp" android:padding="18dp" android:background="@color/aether_panel_2"/>
                </LinearLayout>
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/aether_muted" android:textSize="10sp" android:fontFamily="monospace"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
